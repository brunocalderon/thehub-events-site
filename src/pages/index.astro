---
import AppHeaderBrand from "@/components/app-header-brand.astro";
import { EventsList } from "@/components/events-list";
import Layout from "@/layouts/Layout.astro";
import type { HubEvent } from "@/data/events";
import { resolveBuildSecret } from "@/lib/site-config";
import publicEvents from "@/generated/public-events.json";

const events = publicEvents as HubEvent[];
const eventPublishingFormUrl = resolveBuildSecret("EVENT_PUBLISHING_FORM");
---

<Layout>
	<main class="mx-auto flex w-full max-w-7xl flex-col gap-8 px-4 py-10 md:px-6">
		<div class="flex w-full flex-col gap-6">
			<header class="flex flex-col gap-3">
				<AppHeaderBrand />
				<div class="flex max-w-prose flex-col gap-2 text-sm text-muted-foreground">
					<p>
						Community meetups, talks, and gatherings for English speakers in Chile.
					</p>
					{eventPublishingFormUrl ? (
						<p>
							Organizing something for the community?{" "}
							<a
								href={eventPublishingFormUrl}
								target="_blank"
								rel="noopener noreferrer"
								class="text-muted-foreground underline underline-offset-4 hover:text-foreground"
							>
								Publish your event
							</a>
							.
						</p>
					) : null}
				</div>
			</header>
			<EventsList client:load events={events} />
		</div>
	</main>
</Layout>