---
import AppHeaderBrand from "@/components/app-header-brand.astro";
import { EventDetailLumaLayout } from "@/components/event-detail-luma-layout";
import { buttonVariants } from "@/components/ui/button";
import Layout from "@/layouts/Layout.astro";
import { cn } from "cn";
import type { HubEvent } from "@/data/events";
import publicEvents from "@/generated/public-events.json";

export function getStaticPaths() {
	const events = publicEvents as HubEvent[];
	return events.map((event) => ({
		params: { id: event.id },
		props: { event },
	}));
}

interface Props {
	event: HubEvent;
}

const { event } = Astro.props;
---

<Layout>
	<main class="mx-auto flex w-full max-w-7xl flex-col gap-8 px-4 pt-4 pb-10 md:px-6 md:pt-6">
		<header class="flex w-full flex-wrap items-center justify-between gap-3">
			<AppHeaderBrand />
			<a
				href="/"
				class={cn(
					buttonVariants({ variant: "outline", size: "default" }),
					"h-9 w-fit shrink-0 border-black bg-foreground px-3 text-sm text-background hover:bg-foreground/90 hover:text-background",
				)}
			>
				← All events
			</a>
		</header>

		<article class="w-full min-w-0">
			<EventDetailLumaLayout client:load event={event} />
		</article>
	</main>
</Layout>